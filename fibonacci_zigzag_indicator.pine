//@version=5
indicator("Fibonacci φ Pack with ZigZag", overlay=true, max_lines_count=200, max_labels_count=200)

// ── ZigZag Configuration ──────────────────────────────────────────────────────
Depth = input.int(12, 'Depth', minval=1, step=1, group="ZigZag Config", tooltip="ZigZag depth parameter")
Deviation = input.int(5, 'Deviation', minval=1, step=1, group="ZigZag Config", tooltip="ZigZag deviation parameter")
Backstep = input.int(2, 'Backstep', minval=2, step=1, group="ZigZag Config", tooltip="ZigZag backstep parameter")
showZigZagPoints = input.bool(true, "Show ZigZag Pivot Points", group="ZigZag Config")

// ── Fibonacci Level Visibility ────────────────────────────────────────────────
showRetr      = input.bool(true,  "Show retracements 0↔1", group="Fibonacci Levels")
showExtPos    = input.bool(true,  "Show positive extensions (>1)", group="Fibonacci Levels")
showExtNeg    = input.bool(true,  "Show negative mirrors (<0)", group="Fibonacci Levels")
showDeep      = input.bool(true,  "Include deep levels 0.786 / 0.886 / √φ", group="Fibonacci Levels")
showMidpoint  = input.bool(true,  "Include 0.5 midpoint", group="Fibonacci Levels")
show3618      = input.bool(true,  "Include 3.618 (1+φ²)", group="Fibonacci Levels")

// ── Fibonacci Line Styling ────────────────────────────────────────────────────
fibLineColor = input.color(color.gray, "Fibonacci Line Color", group="Fibonacci Styling")
fibLineWidth = input.int(2, "Fibonacci Line Width", minval=1, maxval=5, group="Fibonacci Styling")
fibLineTransparency = input.int(0, "Fibonacci Line Transparency", minval=0, maxval=100, group="Fibonacci Styling")
retracementLineWidth = input.int(1, "Retracement Line Width (0-100%)", minval=1, maxval=5, group="Fibonacci Styling")
extendLines = input.bool(true, "Extend Lines to Right", group="Fibonacci Styling")

// ── Fibonacci Label Styling ───────────────────────────────────────────────────
fibLabelColor = input.color(color.gray, "Label Text Color", group="Label Styling")
fibLabelBgColor = input.color(#f1f1f5, "Label Background Color", group="Label Styling")
fibLabelTransparency = input.int(0, "Label Text Transparency", minval=0, maxval=100, group="Label Styling")
fibLabelBgTransparency = input.int(0, "Label Background Transparency", minval=0, maxval=100, group="Label Styling")
fibLabelSize = switch input.int(1, "Label Size", minval=1, maxval=5, group="Label Styling")
    1 => size.tiny
    2 => size.small
    3 => size.normal
    4 => size.large
    5 => size.huge

// ── Pivot Point Styling ───────────────────────────────────────────────────────
bullColor = input.color(color.lime, "Bull Pivot Color", group="Pivot Styling")
bearColor = input.color(color.red, "Bear Pivot Color", group="Pivot Styling")
pivotLabelTransparency = input.int(0, "Pivot Label Transparency", minval=0, maxval=100, group="Pivot Styling")
pivotBgTransparency = input.int(20, "Pivot Background Transparency", minval=0, maxval=100, group="Pivot Styling")
pivotLabelSize = switch input.int(2, "Pivot Label Size", minval=1, maxval=5, group="Pivot Styling")
    1 => size.tiny
    2 => size.small
    3 => size.normal
    4 => size.large
    5 => size.huge

// ── φ definitions ──────────────────────────────────────────────────────────────
phi  = (1 + math.sqrt(5)) / 2.0
iphi = 1.0 / phi

// ── Levels from φ ─────────────────────────────────────────────────────────────
r236 = math.pow(iphi, 3)
r382 = math.pow(iphi, 2)
r618 = iphi
r786 = math.sqrt(iphi)
r886 = math.sqrt(r786)

e1236 = 1 + r236
e1272 = math.sqrt(phi)
e1382 = 1 + r382
e1618 = phi
e2618 = math.pow(phi, 2)
e4236 = math.pow(phi, 3)
e3618 = 1 + math.pow(phi, 2)

// Full ordered list (negatives → 0..1 → positives)
var float[] levels = array.from(-e4236, -e2618, -e1618, -e1382, -e1272, -1.0, -r618, -r382, -r236, 0.0, r236, r382, 0.5, r618, r786, r886, 1.0, e1236, e1272, e1382, e1618, e2618, e3618, e4236)
var string[] labels = array.from("-423.6%", "-261.8%", "-161.8%", "-138.2%", "-127.2%", "-100%", "-61.8%", "-38.2%", "-23.6%", "0%", "23.6%", "38.2%", "50%", "61.8%", "78.6%", "88.6%", "100%", "123.6%", "127.2%", "138.2%", "161.8%", "261.8%", "361.8%", "423.6%")

// Visibility filter
f_isVisible(level) =>
    (level < 0 and showExtNeg) or (level >= 0 and level <= 1 and ((showRetr and (level == 0 or level == 1 or level == r236 or level == r382 or (showMidpoint and level == 0.5) or level == r618)) or (showDeep and (level == r786 or level == r886)))) or (level > 1 and showExtPos and (level == e1236 or level == e1272 or level == e1382 or level == e1618 or level == e2618 or (show3618 and level == e3618) or level == e4236))

// ── ZigZag Logic (embedded from library) ──────────────────────────────────────
hr = ta.barssince(not (high[-ta.highestbars(Depth)] - high > Deviation*syminfo.mintick)[1])
lr = ta.barssince(not (low - low[-ta.lowestbars(Depth)] > Deviation*syminfo.mintick)[1])
direction = ta.barssince(not (hr > lr)) >= Backstep ? -1 : 1

var float z_price = low
var int z_time = time
var float z0_price = low
var int z0_time = time
var float z1_price = low
var int z1_time = time
var float z2_price = high
var int z2_time = time

if ta.change(direction)
    z0_price := z1_price
    z0_time := z1_time
    z1_price := z2_price
    z1_time := z2_time
    z2_price := z_price
    z2_time := z_time

if direction > 0
    if high > z2_price
        z2_price := high
        z2_time := time
        z_price := low
        z_time := time
    if low < z_price
        z_price := low
        z_time := time

if direction < 0
    if low < z2_price
        z2_price := low
        z2_time := time
        z_price := high
        z_time := time
    if high > z_price
        z_price := high
        z_time := time

// ── Anchors P0 (0%) and P1 (100%) from ZigZag ─────────────────────────────────
// Using z0 and z1 (previous two pivots, not the most recent two)
P0 = math.min(z0_price, z1_price)
P1 = math.max(z0_price, z1_price)

R = P1 - P0
barsSpan = math.max(5, math.min(250, 500))
x1 = bar_index - barsSpan
x2 = bar_index

var line[] lines = array.new_line(array.size(levels))
var label[] tags = array.new_label(array.size(levels))

for i = 0 to array.size(levels) - 1
    lvl = array.get(levels, i)
    vis = f_isVisible(lvl)

    // Price at this level
    price = P0 + R * lvl

    // Create containers once (use na() to test emptiness)
    if na(array.get(lines, i))
        array.set(lines, i, line.new(x1, price, x2, price, extend=extendLines ? extend.right : extend.none))
    if na(array.get(tags, i))
        array.set(tags, i, label.new(x2, price, "", textalign=text.align_left, style=label.style_label_left, size=fibLabelSize))

    // Update line
    ln = array.get(lines, i)
    isRetracement = price >= P0 and price <= P1
    lineWidth = isRetracement ? retracementLineWidth : fibLineWidth

    line.set_xy1(ln, x1, price)
    line.set_xy2(ln, x2, price)
    line.set_extend(ln, extendLines ? extend.right : extend.none)
    line.set_style(ln, isRetracement ? line.style_dotted : line.style_solid)
    line.set_width(ln, lineWidth)
    line.set_color(ln, vis ? color.new(fibLineColor, fibLineTransparency) : color.new(fibLineColor, 100))

    // Update label
    lb = array.get(tags, i)
    lvlTxt = array.get(labels, i)
    label.set_xy(lb, x2, price)
    label.set_text(lb, vis ? (str.format("{0}  {1,number,######0.########}", lvlTxt, price)) : "")
    label.set_textcolor(lb, vis ? color.new(fibLabelColor, fibLabelTransparency) : color.new(fibLabelColor, 100))
    label.set_style(lb, label.style_label_left)
    label.set_size(lb, fibLabelSize)
    label.set_color(lb, color.new(fibLabelBgColor, fibLabelBgTransparency))

// ── Optional: Show ZigZag swing points ────────────────────────────────────────
if showZigZagPoints and ta.change(direction)
    var label pivotLabel = na
    label.delete(pivotLabel[1])

    string pointType = ""
    var float lastPivot = z1_price[1]

    if direction[1] < 0
        pointType := z2_price < lastPivot ? "LL" : "HL"
    else
        pointType := z2_price > lastPivot ? "HH" : "LH"

    // Position label above highs (HH, LH) and below lows (LL, HL)
    labelStyle = direction[1] > 0 ? label.style_label_down : label.style_label_up
    pivotColor = direction[1] < 0 ? bearColor : bullColor

    pivotLabel := label.new(
         bar_index[1], z2_price[1],
         pointType,
         xloc.bar_index,
         yloc.price,
         color.new(pivotColor, pivotBgTransparency),
         labelStyle,
         color.new(pivotColor, pivotLabelTransparency),
         pivotLabelSize
     )
